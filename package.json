{
  "name": "canopy-mongo",
  "productName": "Canopy",
  "version": "0.4.0",
  "description": "A calm, open-source MongoDB workspace for developers.",
  "author": "Canopy contributors",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz",
    "dist:dir": "npm run build && electron-builder --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win",
    "test:desktop": "playwright test --config playwright.desktop.config.ts",
    "format": "prettier --write src electron shared scripts/*.mjs tests *.config.ts package.json tsconfig.json README.md docs/*.md",
    "format:check": "prettier --check src electron shared scripts/*.mjs tests *.config.ts package.json tsconfig.json README.md docs/*.md",
    "test:performance": "playwright test --config playwright.performance.config.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.0",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.8.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@uiw/react-codemirror": "^4.23.0",
    "bson": "^6.10.0",
    "lucide-react": "^0.468.0",
    "mingo": "^6.6.0",
    "mongodb": "^6.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "dev.canopy.mongo",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "resources/icon.png",
      "package.json",
      "LICENSE"
    ],
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Development",
      "icon": "resources/icon.png",
      "maintainer": "Canopy contributors",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "icon": "resources/icon.png",
    "electronDist": "node_modules/electron/dist",
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE.canopy.txt"
      }
    ]
  },
  "desktopName": "dev.canopy.mongo.desktop",
  "engines": {
    "node": ">=22.19.0"
  }
}
